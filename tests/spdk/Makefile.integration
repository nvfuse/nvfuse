SPDK_ROOT_DIR ?= $(HOME)/src/spdk
NVFUSE_ROOT_DIR ?= $(abspath ../..)
NVFUSE_BUILD ?= $(NVFUSE_ROOT_DIR)/build/spdk-core
APP ?= integration_test

include $(SPDK_ROOT_DIR)/mk/spdk.common.mk
include $(SPDK_ROOT_DIR)/mk/spdk.modules.mk
C_SRCS = $(APP).c
ifeq ($(APP),integration_mixed)
CXX_SRCS = integration_mixed_oracle.cpp
SYS_LIBS += -lstdc++
CXXFLAGS += -std=c++17
endif
CFLAGS += -D_GNU_SOURCE -DDEBUG -DNVFUSE_FILE_BACKEND -DNVFUSE_SPDK_TRANSPORT -DNVFUSE_NVME_TEST_HOOKS -I$(NVFUSE_ROOT_DIR)/include
LIBS += $(NVFUSE_BUILD)/nvfuse.a $(NVFUSE_BUILD)/nvfuse_nvme_transport.o -lpthread -lm
SPDK_LIB_LIST += $(SOCK_MODULES_LIST) nvme
include $(SPDK_ROOT_DIR)/mk/spdk.app.mk
ifeq ($(APP),integration_mixed)
# spdk.common.mk defaults to C++11; the model requires C++17.
CXXFLAGS += -std=c++17
endif

$(APP): nvfuse-core $(NVFUSE_BUILD)/nvfuse_nvme_transport.o

.PHONY: nvfuse-core
nvfuse-core:
	$(MAKE) -C $(NVFUSE_ROOT_DIR) -f Makefile.local LOCAL_BUILD=$(NVFUSE_BUILD) LOCAL_CPPFLAGS=-DNVFUSE_SPDK_TRANSPORT $(NVFUSE_BUILD)/nvfuse.a

$(NVFUSE_BUILD)/nvfuse_nvme_transport.o: $(NVFUSE_ROOT_DIR)/src/nvfuse_nvme_transport.c $(NVFUSE_ROOT_DIR)/include/nvfuse_nvme_transport.h
	@mkdir -p $(NVFUSE_BUILD)
	$(CC) -std=gnu11 -O1 -g -Wall -Wextra -Werror -DNVFUSE_NVME_TEST_HOOKS -I$(SPDK_ROOT_DIR)/include -I$(NVFUSE_ROOT_DIR)/include -c $< -o $@
