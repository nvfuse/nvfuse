# Native macOS/Linux file-image build. Does not use SPDK, DPDK or FUSE.
CC = clang
LOCAL_BUILD ?= build/local
LOCAL_CFLAGS ?= -O1 -g
CPPFLAGS += -D_GNU_SOURCE -DDEBUG -DNVFUSE_FILE_BACKEND -Iinclude
CPPFLAGS += $(LOCAL_CPPFLAGS)
CFLAGS = -std=gnu11 $(LOCAL_CFLAGS) -Wall -Wextra -Wno-unused-parameter -Wno-sign-compare -Wno-unused-variable -Wno-unused-function -Wno-format -Wno-pointer-sign
SOURCES = nvfuse_buffer_cache.c nvfuse_inode_cache.c nvfuse_core.c \
 nvfuse_gettimeofday.c nvfuse_bp_tree.c nvfuse_dirhash.c nvfuse_misc.c \
 nvfuse_mkfs.c nvfuse_malloc.c nvfuse_indirect.c nvfuse_api.c nvfuse_aio.c \
 rbtree.c nvfuse_dep.c nvfuse_ipc_ring.c nvfuse_control_plane.c nvfuse_xattr.c \
 nvfuse_portable.c nvfuse_file.c nvfuse_journal.c nvfuse_tx.c nvfuse_tx_wrappers.c
OBJECTS = $(SOURCES:%.c=$(LOCAL_BUILD)/%.o)
.DEFAULT_GOAL := all
.PHONY: all test framework-test clean
all: $(LOCAL_BUILD)/local_test $(LOCAL_BUILD)/framework_test
$(LOCAL_BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -MMD -MP -c $< -o $@
# Keep strict warnings for the new backend and its executable.
$(LOCAL_BUILD)/nvfuse_journal.o $(LOCAL_BUILD)/nvfuse_tx.o $(LOCAL_BUILD)/nvfuse_tx_wrappers.o $(LOCAL_BUILD)/nvfuse_portable.o $(LOCAL_BUILD)/nvfuse_file.o $(LOCAL_BUILD)/tests/local_test.o $(LOCAL_BUILD)/tests/framework_test.o: CFLAGS = -std=gnu11 $(LOCAL_CFLAGS) -Wall -Wextra -Werror
$(LOCAL_BUILD)/nvfuse.a: $(OBJECTS)
	$(AR) rcs $@ $^
$(LOCAL_BUILD)/local_test: $(LOCAL_BUILD)/tests/local_test.o $(LOCAL_BUILD)/nvfuse.a
	$(CC) $(LOCAL_CFLAGS) $^ -lpthread -lm -o $@
$(LOCAL_BUILD)/framework_test: $(LOCAL_BUILD)/tests/framework_test.o $(LOCAL_BUILD)/nvfuse.a
	$(CC) $(LOCAL_CFLAGS) $^ -lpthread -lm -o $@
test: all
	python3 tests/run_local.py $(LOCAL_BUILD)/local_test
framework-test: all
	python3 tests/run_framework.py --binary $(LOCAL_BUILD)/framework_test
clean:
	rm -rf $(LOCAL_BUILD)
-include $(OBJECTS:.o=.d) $(LOCAL_BUILD)/tests/local_test.d $(LOCAL_BUILD)/tests/framework_test.d $(LOCAL_BUILD)/tests/transaction_test.d $(LOCAL_BUILD)/tests/journal_bench.d

$(LOCAL_BUILD)/journal_engine_test: tests/journal_engine_test.c nvfuse_journal.c include/nvfuse_journal.h
	@mkdir -p $(dir $@)
	$(CC) -std=gnu11 $(LOCAL_CFLAGS) -Wall -Wextra -Werror -Iinclude tests/journal_engine_test.c nvfuse_journal.c -o $@
$(LOCAL_BUILD)/transaction_test: $(LOCAL_BUILD)/tests/transaction_test.o $(LOCAL_BUILD)/nvfuse.a
	$(CC) $(LOCAL_CFLAGS) $^ -lpthread -lm -o $@
.PHONY: journal-test
journal-test: $(LOCAL_BUILD)/journal_engine_test $(LOCAL_BUILD)/transaction_test
	$(LOCAL_BUILD)/journal_engine_test
	python3 tests/run_transactions.py $(LOCAL_BUILD)/transaction_test

$(LOCAL_BUILD)/journal_bench: $(LOCAL_BUILD)/tests/journal_bench.o $(LOCAL_BUILD)/nvfuse.a
	$(CC) $(LOCAL_CFLAGS) $^ -lpthread -lm -o $@
.PHONY: journal-bench
journal-bench: $(LOCAL_BUILD)/journal_bench
	python3 tests/run_journal_bench.py $(LOCAL_BUILD)/journal_bench
